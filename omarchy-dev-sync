#!/bin/bash

# Sync an Omarchy checkout with upstream and rebuild an integration branch
# from your open PRs, so an `omarchy dev link` environment tests every
# PR patch together. Open omarchy-pkgs PRs of yours are merged into a
# disposable worktree for the package rebuild, so packaging fixes ship in
# the same sync that tests them.

set -euo pipefail

script_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
source "$script_dir/lib/package-state.sh"
source "$script_dir/lib/self-update.sh"
source "$script_dir/lib/dev-package-sources.sh"
original_args=("$@")
package_state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-dev-sync/packages

config_dir=${OMARCHY_DEV_SYNC_CONFIG:-"$HOME/.config/omarchy-dev-sync"}
repo=$HOME/src/omarchy
upstream=origin
fork=fork
head=quattro
integration=integration-prs
restart=1
pkg_build=1
pkgs_repo=$HOME/Work/omarchy/omarchy-pkgs
pkgs_prs=1
runtime_packages="quickshell"
self_update=1
package_sources=1

if [[ -f $config_dir/config ]]; then
  # shellcheck disable=SC1091
  source "$config_dir/config"
fi

repo=${OMARCHY_DEV_SYNC_REPO:-$repo}
upstream=${OMARCHY_DEV_SYNC_UPSTREAM:-$upstream}
fork=${OMARCHY_DEV_SYNC_FORK:-$fork}
head=${OMARCHY_DEV_SYNC_HEAD:-$head}
integration=${OMARCHY_DEV_SYNC_INTEGRATION:-$integration}
restart=${OMARCHY_DEV_SYNC_RESTART:-$restart}
pkg_build=${OMARCHY_DEV_SYNC_PKG:-$pkg_build}
pkgs_repo=${OMARCHY_DEV_SYNC_PKGS_REPO:-$pkgs_repo}
pkgs_prs=${OMARCHY_DEV_SYNC_PKGS_PRS:-$pkgs_prs}
runtime_packages=${OMARCHY_DEV_SYNC_RUNTIME_PACKAGES-$runtime_packages}
self_update=${OMARCHY_DEV_SYNC_SELF_UPDATE:-$self_update}
package_sources=${OMARCHY_DEV_SYNC_PACKAGE_SOURCES:-$package_sources}

usage() {
  cat <<USAGE
Usage: omarchy-dev-sync [--no-restart] [--no-pkg] [--no-self-update] [--no-package-sources]

  Fetch $upstream/$head and rebuild $integration by merging every open PR
of yours (plus optional extra branches) so an omarchy-dev-link checkout
runs them together. When the dev packages are rebuilt, your open
omarchy-pkgs PRs are merged into a disposable worktree first, so the
packages under test include your packaging fixes.

  --no-self-update  Skip checking this script's Git tracking branch for updates.
  --no-package-sources  Leave package mirror/channel configuration unchanged.
  --no-restart  Do not restart the live Omarchy shell after a successful rebuild.
  --no-pkg      Do not rebuild and install the dev packages after a successful
                rebuild.

Config (bash assignments, then extra-branches):
  $config_dir/config
  $config_dir/extra-branches
  $config_dir/extra-prs (upstream PR numbers, including other authors)

Environment overrides the config file:
  OMARCHY_DEV_SYNC_SELF_UPDATE   Update this script before syncing (default: 1)
  OMARCHY_DEV_SYNC_PACKAGE_SOURCES  Align active dev-link mirrors with edge (default: 1)
  OMARCHY_DEV_SYNC_REPO          Omarchy checkout (default: $repo)
  OMARCHY_DEV_SYNC_UPSTREAM      Upstream remote (default: $upstream)
  OMARCHY_DEV_SYNC_FORK          Your fork remote (default: $fork)
  OMARCHY_DEV_SYNC_HEAD          Upstream branch (default: $head)
  OMARCHY_DEV_SYNC_INTEGRATION   Integration branch (default: $integration)
  OMARCHY_DEV_SYNC_PKG           Rebuild+install dev packages (default: 1)
  OMARCHY_DEV_SYNC_PKGS_REPO     omarchy-pkgs checkout (default: $pkgs_repo)
  OMARCHY_DEV_SYNC_PKGS_PRS      Merge your open omarchy-pkgs PRs for the
                                 package build (default: 1)
  OMARCHY_DEV_SYNC_RUNTIME_PACKAGES  Installed runtime packages to refresh
                                 (default: quickshell; empty disables)
  OMARCHY_PKGBUILDS_DIR          Use these PKGBUILDs as-is, skipping the
                                 omarchy-pkgs PR merge
  OMARCHY_DEV_SYNC_CONFIG        Config directory (default: $config_dir)
USAGE
}

while (($#)); do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --no-restart)
      restart=0
      shift
      ;;
    --no-self-update)
      self_update=0
      shift
      ;;
    --no-package-sources)
      package_sources=0
      shift
      ;;
    --no-pkg)
      pkg_build=0
      shift
      ;;
    *)
      echo "Error: unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ $self_update == 1 ]]; then
  self_update_checkout "$script_dir" "$script_dir/omarchy-dev-sync" "${original_args[@]}"
  refresh_local_dev_skills "$script_dir/skills/omarchy-dev"
fi
unset OMARCHY_DEV_SYNC_SELF_UPDATED

if [[ ! -d $repo/.git ]]; then
  echo "Error: not a git repo: $repo" >&2
  exit 1
fi
cd "$repo"
repo=$(git rev-parse --show-toplevel)

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Error: $repo has uncommitted changes. Commit or stash them, then rerun." >&2
  exit 1
fi

command -v gh >/dev/null || { echo "Error: gh not installed." >&2; exit 1; }

upstream_url=$(git remote get-url "$upstream")
slug=${upstream_url#*github.com[:/]}
slug=${slug%.git}

start_branch=$(git branch --show-current)

git config rerere.enabled true
git config rerere.autoUpdate true

git fetch "$upstream" --prune
git fetch "$fork" --prune

# Fast-forward the local head branch from upstream. A failure means the local
# branch diverged; warn and keep going with the remote tip for the merge.
if ! git fetch "$upstream" "$head:$head" 2>/dev/null; then
  echo "Warning: local $head diverged from $upstream/$head; not updated." >&2
fi

declare -A pr_seen=()
pr_branches=()
pr_labels=()
# Process substitution does not trip `set -e`; capture gh's status ourselves
# so an API timeout cannot look like "no open PRs" and strip the integration
# branch down to upstream.
pr_tsv=
if ! pr_tsv=$(gh pr list --repo "$slug" --author @me --state open --json number,title,headRefName --jq '.[] | [.number, .headRefName, .title] | @tsv'); then
  echo "Error: gh pr list failed (GitHub API unreachable?). Leaving $integration alone." >&2
  exit 1
fi
while IFS=$'\t' read -r number name title; do
  [[ -n $name ]] || continue
  [[ -z ${pr_seen[$name]+x} ]] || continue
  pr_seen[$name]=1
  pr_branches+=("$name")
  pr_labels+=("#$number $name"$'\t'"$title")
done < <(printf '%s\n' "$pr_tsv" | sort -t$'\t' -k2,2)

if (( ${#pr_branches[@]} == 0 )); then
  echo "No open PRs found for $slug; syncing $head only."
fi

# Branches merged beyond open PRs. Delete a line once its PR opens;
# gh picks it up automatically.
extra_branches=()
extra_file=$config_dir/extra-branches
if [[ -f $extra_file ]]; then
  mapfile -t extra_branches < <(grep -vE '^[[:space:]]*(#|$)' "$extra_file" || true)
fi

for branch in "${extra_branches[@]}"; do
  if [[ -n ${pr_seen[$branch]+x} ]]; then
    echo "Warning: extra-branches lists $branch, which already has an open PR; remove that line." >&2
  fi
done

branch_worktree() {
  local branch=$1
  git worktree list --porcelain | awk -v b="refs/heads/$branch" '
    $1 == "worktree" { path = $2 }
    $1 == "branch" && $2 == b { print path; exit }
  '
}

merge_refs=()
for branch in "${pr_branches[@]}" "${extra_branches[@]}"; do
  [[ $branch == "$integration" ]] && continue
  worktree=$(branch_worktree "$branch")
  if [[ -n $worktree && $worktree != "$repo" ]]; then
    echo "Warning: $branch is checked out in $worktree; merging $fork/$branch without updating local." >&2
  else
    fetch_err=$(git fetch "$fork" "$branch:$branch" 2>&1) || {
      if [[ $fetch_err == *'checked out at'* ]]; then
        echo "Warning: $branch is checked out elsewhere; merging $fork/$branch without updating local." >&2
      elif [[ $fetch_err == *'non-fast-forward'* ]]; then
        echo "Warning: local $branch diverged from $fork/$branch; merging the fork tip as-is." >&2
      else
        echo "Warning: could not update local $branch; merging $fork/$branch as-is." >&2
        printf '%s\n' "$fetch_err" | sed 's/^/  /' >&2
      fi
    }
  fi
  if git show-ref --verify --quiet "refs/remotes/$fork/$branch"; then
    merge_refs+=("$fork/$branch")
  else
    echo "Warning: $branch not found on $fork remote; skipping." >&2
  fi
done

# Include an explicitly selected upstream PR without duplicating its review.
extra_prs=()
if [[ -f $config_dir/extra-prs ]]; then
  mapfile -t extra_prs < <(sed -E 's/#.*$//; s/^[[:space:]]+//; s/[[:space:]]+$//; /^$/d' "$config_dir/extra-prs")
fi
for number in "${extra_prs[@]}"; do
  if [[ ! $number =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: invalid upstream PR number in extra-prs: $number" >&2
    exit 1
  fi
  ref="refs/remotes/$upstream/pull/$number"
  if ! git fetch --quiet "$upstream" "+pull/$number/head:$ref"; then
    echo "Error: could not fetch selected PR #$number; leaving $integration alone." >&2
    exit 1
  fi
  merge_refs+=("$ref")
  pr_labels+=("selected #$number")
done

if (( ${#merge_refs[@]} > 0 )); then
  mapfile -t merge_refs < <(printf '%s\n' "${merge_refs[@]}" | sort -u)
fi

old_integration=$(git rev-parse --verify "refs/heads/$integration" 2>/dev/null || true)

# The colour_only/denied template lists in theme-staging-test.sh are
# append-only sets: upstream and PRs each add entries, so the conflict is
# always two versions of one array line. A sorted union of both sides is the
# correct resolution, and the test itself fails loudly if a template is
# misplaced, so a wrong union gets caught downstream.
resolve_theme_staging_union() {
  local conflicted
  conflicted=$(git diff --name-only --diff-filter=U)
  [[ $conflicted == "test/shell.d/theme-staging-test.sh" ]] || return 1
  python3 - <<'PYEOF' || return 1
import re
p = "test/shell.d/theme-staging-test.sh"
s = open(p).read()
pattern = r"<<<<<<< HEAD\n(.*?)\n=======\n(.*?)\n>>>>>>> [^\n]*\n"
blocks = re.findall(pattern, s, re.S)
if not blocks:
    raise SystemExit(1)
for ours, theirs in blocks:
    m1 = re.fullmatch(r"(\w+)=\((.*)\)", ours)
    m2 = re.fullmatch(r"(\w+)=\((.*)\)", theirs)
    if not (m1 and m2 and m1.group(1) == m2.group(1)):
        raise SystemExit(1)
    items = dict.fromkeys(m1.group(2).split() + m2.group(2).split())
    union = m1.group(1) + "=(" + " ".join(sorted(items)) + ")"
    s, n = re.subn(pattern, union + "\n", s, count=1, flags=re.S)
    if n != 1:
        raise SystemExit(1)
open(p, "w").write(s)
PYEOF
}

git checkout -q --no-track -B "$integration" "$upstream/$head"

restore_on_failure() {
  local conflicted
  conflicted=$(git diff --name-only --diff-filter=U || true)
  git merge --abort 2>/dev/null || true
  if [[ -n $old_integration ]]; then
    git checkout -B "$integration" "$old_integration"
  fi
  if [[ -n $start_branch ]]; then
    git checkout "$start_branch"
  fi
  echo "Error: merge conflict while building $integration. Old state restored. Resolve by hand." >&2
  if [[ -n $conflicted ]]; then
    echo "Conflicted files:" >&2
    while IFS= read -r file; do
      printf '  %s\n' "$file" >&2
    done <<<"$conflicted"
  fi
  exit 1
}

if (( ${#merge_refs[@]} > 0 )); then
  echo "Merging ${#merge_refs[@]} branches into $integration:"
  if (( ${#pr_labels[@]} > 0 )); then
    printf '  %s\n' "${pr_labels[@]}"
  fi
  for branch in "${extra_branches[@]}"; do
    [[ -n ${pr_seen[$branch]+x} ]] && continue
    echo "  extra $branch"
  done
  for ref in "${merge_refs[@]}"; do
    if ! git merge --no-edit "$ref" >/dev/null 2>&1; then
      # rerere replays known resolutions and stages them; an unresolved
      # conflict still shows up in the index.
      if [[ -n $(git diff --name-only --diff-filter=U) ]]; then
        resolve_theme_staging_union || restore_on_failure
        if [[ -n $(git diff --name-only --diff-filter=U) ]]; then
          restore_on_failure
        fi
        git add test/shell.d/theme-staging-test.sh
      fi
      git commit --no-edit >/dev/null
    fi
  done
fi

# Lease against the fork tip we just fetched, not the previous local
# integration SHA. Local and remote are both disposable rebuilds and often
# diverge (last run pushed, this run rebuilt on a newer quattro).
push_status="push skipped"
if git fetch --quiet "$fork" "$integration" 2>/dev/null; then
  remote_tip=$(git rev-parse --verify "refs/remotes/$fork/$integration" 2>/dev/null || true)
else
  remote_tip=
  echo "Warning: could not re-fetch $fork/$integration; not pushing." >&2
fi
if [[ -n $remote_tip ]]; then
  if git push --quiet "$fork" "refs/heads/$integration" --force-with-lease="refs/heads/$integration:$remote_tip"; then
    push_status="pushed to $fork"
    git branch -u "$fork/$integration" >/dev/null
  else
    push_status="push skipped (remote moved during push or push failed)"
    echo "Warning: $push_status." >&2
  fi
elif git show-ref --verify --quiet "refs/remotes/$fork/$integration"; then
  echo "Warning: push skipped (could not refresh $fork/$integration)." >&2
elif git push --quiet -u "$fork" "refs/heads/$integration"; then
  push_status="pushed to $fork (new branch)"
else
  echo "Warning: push skipped (creating $fork/$integration failed)." >&2
fi

newest=$(git rev-parse --short HEAD)
pr_count=${#merge_refs[@]}

# Helpers that fail closed when the checkout and the packaged copy differ,
# i.e. exactly the ones that refuse to elevate on a stale package.
packaged_skew() {
  PACKAGED_SKEW=()
  local cmd pkg
  for cmd in "$repo"/bin/omarchy-*; do
    [[ -f $cmd ]] || continue
    grep -q 'privileged_copy_matches' "$cmd" 2>/dev/null || continue
    pkg=/usr/bin/${cmd##*/}
    [[ -f $pkg ]] || continue
    cmp -s "$cmd" "$pkg" && continue
    PACKAGED_SKEW+=("${cmd##*/}")
  done
  return 0
}

# Build the dev packages from a disposable worktree of the pkgs checkout
# with your open omarchy-pkgs PRs merged, so packaging fixes ship in the
# same sync that tests them. The checkout itself is never touched and
# nothing is pushed: the worktree is removed after the build. Fetch or
# unresolved merge failures stop the package refresh instead of dropping PRs.
# Git rerere may reuse a conflict resolution previously verified by hand.
pkgs_worktree=""
pkgs_pkgbuilds_dir=""
cleanup_pkgs_worktree() {
  if [[ -n $pkgs_worktree && -d $pkgs_worktree ]]; then
    git -C "$pkgs_repo" worktree remove --force "$pkgs_worktree" 2>/dev/null || true
  fi
  pkgs_worktree=""
}
prepare_pkgs_build_dir() {
  local slug pkgs_slug_url base pr_numbers n conflicted merge_output
  pkgs_pkgbuilds_dir=${OMARCHY_PKGBUILDS_DIR:-$pkgs_repo/pkgbuilds}
  if [[ -n ${OMARCHY_PKGBUILDS_DIR:-} ]]; then
    echo "Using OMARCHY_PKGBUILDS_DIR as-is; open omarchy-pkgs PRs will not be merged."
    return 0
  fi
  (( pkgs_prs )) || return 0
  if [[ ! -d $pkgs_repo/.git ]]; then
    return 0
  fi
  # PR heads may live on any fork, so fetch them through the upstream's
  # pull refs instead of tracking branches per fork.
  if ! git -C "$pkgs_repo" fetch --quiet origin --prune 2>/dev/null; then
    echo "Error: could not fetch omarchy-pkgs; refusing to omit packaging patches." >&2
    return 1
  fi
  git -C "$pkgs_repo" worktree prune 2>/dev/null || true
  pkgs_slug_url=$(git -C "$pkgs_repo" remote get-url origin 2>/dev/null) || pkgs_slug_url=""
  slug=${pkgs_slug_url#*github.com[:/]}
  slug=${slug%.git}
  base=$(git -C "$pkgs_repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) || base=""
  if [[ -z $slug || -z $base ]]; then
    echo "Error: could not resolve the omarchy-pkgs upstream." >&2
    return 1
  fi
  if ! pr_numbers=$(gh pr list --repo "$slug" --author @me --state open --json number --jq '.[].number' 2>/dev/null); then
    echo "Error: gh pr list failed for $slug; refusing to omit packaging patches." >&2
    return 1
  fi
  pr_numbers=$(printf '%s\n' "$pr_numbers" | sort -n | tr '\n' ' ')
  pkgs_worktree=$(mktemp -d -t omarchy-dev-sync-pkgs.XXXXXX) || return 1
  trap cleanup_pkgs_worktree EXIT
  if ! git -C "$pkgs_repo" worktree add --detach --quiet "$pkgs_worktree" "$base" 2>/dev/null; then
    echo "Error: could not create the omarchy-pkgs worktree." >&2
    cleanup_pkgs_worktree
    trap - EXIT
    return 1
  fi
  if [[ -n ${pr_numbers// /} ]]; then
    echo "Merging open omarchy-pkgs PRs for the package build:$pr_numbers"
  else
    echo "Using current $base packaging recipes (no open packaging PRs)."
  fi
  for n in $pr_numbers; do
    if ! git -C "$pkgs_worktree" fetch --quiet origin "pull/$n/head" 2>/dev/null; then
      echo "Error: could not fetch omarchy-pkgs PR #$n; refusing to omit it." >&2
      return 1
    fi
    if ! merge_output=$(git -C "$pkgs_worktree" merge --quiet --no-edit FETCH_HEAD 2>&1); then
      conflicted=$(git -C "$pkgs_worktree" diff --name-only --diff-filter=U)
      if [[ -n $conflicted ]] && python3 "$script_dir/lib/resolve-package-versions.py" "$pkgs_worktree"; then
        echo "Resolved independent upstream pkgver / PR pkgrel changes for packaging PR #$n."
        conflicted=$(git -C "$pkgs_worktree" diff --name-only --diff-filter=U)
      fi
      if [[ -n $conflicted ]]; then
        echo "Error: unresolved conflict in omarchy-pkgs PR #$n; refusing to omit it." >&2
        printf '%s\n' "$merge_output" "$conflicted" >&2
        git -C "$pkgs_worktree" merge --abort 2>/dev/null || true
        return 1
      fi
      git -C "$pkgs_worktree" commit --quiet --no-edit || return 1
      echo "Committed resolved packaging PR #$n."
    fi
  done
  if [[ ! -f $pkgs_worktree/pkgbuilds/omarchy-dev/PKGBUILD ]]; then
    echo "Error: merged omarchy-pkgs tree has no PKGBUILDs." >&2
    cleanup_pkgs_worktree
    trap - EXIT
    return 1
  fi
  pkgs_pkgbuilds_dir=$pkgs_worktree/pkgbuilds
}

# Rebuild and install the dev packages from the rebuilt checkout, so the
# packaged copies pkexec runs match the integration tree. The settings and
# main dev packages replace their release counterparts and depend on each
# other, so they go into a single pacman transaction: installed separately,
# the settings package conflicts with the release omarchy that still depends
# on the old omarchy-settings, and pacman answers its remove-conflict prompt
# with the --noconfirm default (no) and aborts.
rebuild_dev_packages() {
  local pkgbuilds_dir build_dir sha dirty pkg dir built
  local -a built_pkgs=()
  pkgbuilds_dir=$pkgs_pkgbuilds_dir
  if [[ ! -f $pkgbuilds_dir/omarchy-dev/PKGBUILD ]]; then
    echo "Note: no omarchy-pkgs checkout at $pkgbuilds_dir; leaving the installed package stale."
    echo "      Clone omacom/omarchy-pkgs there (or point OMARCHY_PKGBUILDS_DIR at one) to automate this."
    return 1
  fi
  if ! command -v makepkg >/dev/null; then
    echo "Note: makepkg not found; leaving the installed package stale." >&2
    return 1
  fi
  sha=$(git -C "$repo" rev-parse --short HEAD)
  dirty=""
  if [[ -n $(git -C "$repo" status --porcelain) ]]; then
    dirty=".dirty"
  fi
  build_dir=$(mktemp -d -t omarchy-dev-sync-pkg.XXXXXX) || return 1
  for pkg in omarchy-settings-dev omarchy-dev; do
    dir="$build_dir/$pkg"
    cp -a "$pkgbuilds_dir/$pkg" "$dir" || return 1
    # Drop the upstream pkgver() so the built package is tagged dev.<sha>.
    if ! awk '
      /^pkgver\(\)[[:space:]]*\{/ {
        in_pkgver = 1
        depth = 0
      }
      in_pkgver {
        line = $0
        opens = gsub(/\{/, "{", line)
        line = $0
        closes = gsub(/\}/, "}", line)
        depth += opens - closes
        if (depth <= 0) {
          in_pkgver = 0
        }
        next
      }
      { print }
    ' "$dir/PKGBUILD" >"$dir/PKGBUILD.tmp" || ! mv "$dir/PKGBUILD.tmp" "$dir/PKGBUILD"; then
      echo "Warning: could not rewrite the pkgver of $pkg." >&2
      return 1
    fi
    sed -i "s/^pkgver=.*/pkgver=dev.$sha$dirty/" "$dir/PKGBUILD"
    # Pin the dev build above any official release. Without this,
    # dev.<sha> sorts below official versions like 4.0.3, so
    # `omarchy update` (pacman -Syu) "upgrades" the dev package back
    # to the release build. epoch=1 beats every epoch-less official
    # version regardless of pkgver.
    if grep -q '^epoch=' "$dir/PKGBUILD"; then
      sed -i 's/^epoch=.*/epoch=1/' "$dir/PKGBUILD"
    elif grep -q '^pkgrel=' "$dir/PKGBUILD"; then
      sed -i 's/^pkgrel=/epoch=1\npkgrel=/' "$dir/PKGBUILD"
    else
      sed -i "s/^pkgver=.*/&\nepoch=1/" "$dir/PKGBUILD"
    fi
  done
  for pkg in omarchy-settings-dev omarchy-dev; do
    dir="$build_dir/$pkg"
    # -d: omarchy-dev lists omarchy-settings-dev as a dependency that only
    # exists after the single-transaction install below.
    if ! (cd "$dir" && OMARCHY_SRC="$repo" makepkg -d --skipchecksums --noconfirm >/dev/null); then
      echo "Warning: makepkg failed for $pkg." >&2
      return 1
    fi
    built=$(ls -t "$dir"/*.pkg.tar.* 2>/dev/null | grep -v '\.sig$' | head -1) || built=""
    [[ -n $built ]] || {
      echo "Warning: no package archive was built for $pkg." >&2
      return 1
    }
    built_pkgs+=("$built")
  done
  if ! install_packages "${built_pkgs[@]}"; then
    echo "Warning: the dev package install failed; packaged copies are stale." >&2
    return 1
  fi
}

restart_live_shell() {
  local session_path
  (( restart )) || return 0
  session_path=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^OMARCHY_PATH=//p' | tail -n 1)
  [[ $session_path == "$repo" ]] || return 0
  command -v omarchy-restart-shell >/dev/null || return 0
  if omarchy-restart-shell; then
    echo "Restarted the live Omarchy shell so it runs this $integration build."
  else
    echo "Warning: $integration rebuilt, but the live shell was not restarted." >&2
  fi
}

install_packages() {
  if [[ -t 0 ]]; then
    sudo pacman -U --noconfirm --ask 4 --overwrite='*' "$@"
  else
    pkexec pacman -U --noconfirm --ask 4 --overwrite='*' "$@"
  fi
}

# Runtime packages are checked independently of privileged-helper skew. Prefer
# a recipe from the merged packaging tree, then the reviewed bundled recipe.
refresh_runtime_packages() {
  local package recipe fingerprint build_dir archive candidate
  local -a archives=()
  for package in $runtime_packages; do
    if [[ ! $package =~ ^[a-zA-Z0-9][a-zA-Z0-9@._+-]*$ ]]; then
      echo "Error: invalid runtime package name: $package" >&2
      return 1
    fi
    pacman -Q "$package" >/dev/null 2>&1 || continue
    recipe=$pkgs_pkgbuilds_dir/$package
    if [[ ! -f $recipe/PKGBUILD ]]; then
      recipe=$script_dir/packages/$package
    fi
    if [[ ! -f $recipe/PKGBUILD ]]; then
      echo "Error: no recipe for installed runtime package $package." >&2
      return 1
    fi
    fingerprint=$(package_fingerprint "$recipe") || return 1
    if package_current "$package" "$fingerprint"; then
      echo "$package matches its recipe and installed ABI dependencies."
      continue
    fi
    echo "Rebuilding $package from $recipe (recipe, dependency or installed version changed)..."
    build_dir=$(mktemp -d -t "omarchy-dev-sync-$package.XXXXXX") || return 1
    cp -a "$recipe/." "$build_dir/" || return 1
    # makepkg must run as the user. Dependency installation needs an interactive
    # terminal; agent calls should install missing build dependencies separately.
    if [[ -t 0 ]]; then
      (cd "$build_dir" && makepkg --syncdeps --noconfirm) || return 1
    else
      (cd "$build_dir" && makepkg --noconfirm) || return 1
    fi
    mapfile -t archives < <(cd "$build_dir" && makepkg --packagelist)
    archive=""
    for candidate in "${archives[@]}"; do
      if [[ -f $candidate && ${candidate##*/} != *-debug-* ]]; then
        archive=$candidate
        break
      fi
    done
    if [[ -z $archive ]]; then
      echo "Error: no runtime package archive was built for $package." >&2
      return 1
    fi
    install_packages "$archive" || return 1
    record_package "$package" "$fingerprint" || return 1
    rm -rf "$build_dir"
  done
}

packaged_skew
if (( pkg_build )); then
  prepare_pkgs_build_dir
  # Check packaging-only changes even when all privileged helpers match.
  dev_fingerprint=""
  if [[ -f $pkgs_pkgbuilds_dir/omarchy-dev/PKGBUILD && -f $pkgs_pkgbuilds_dir/omarchy-settings-dev/PKGBUILD ]]; then
    dev_fingerprint=$(package_fingerprint "$pkgs_pkgbuilds_dir/omarchy-dev")
    settings_fingerprint=$(package_fingerprint "$pkgs_pkgbuilds_dir/omarchy-settings-dev")
    dev_fingerprint="$dev_fingerprint $settings_fingerprint"
    if (( ${#PACKAGED_SKEW[@]} > 0 )) || ! package_current omarchy-dev "$dev_fingerprint" || ! package_current omarchy-settings-dev "$dev_fingerprint"; then
      echo "Rebuilding dev packages (privileged helpers or packaging recipes changed)..."
      if rebuild_dev_packages; then
        record_package omarchy-dev "$dev_fingerprint"
        record_package omarchy-settings-dev "$dev_fingerprint"
      else
        echo "Error: dev package refresh failed; keeping the running shell." >&2
        exit 1
      fi
    fi
  fi
  if ! refresh_runtime_packages; then
    echo "Error: runtime package refresh failed; keeping the running shell." >&2
    exit 1
  fi
fi
packaged_skew
if (( ${#PACKAGED_SKEW[@]} > 0 )); then
  echo "Note: checkout and packaged copies still differ for: ${PACKAGED_SKEW[*]}"
  echo "      pkexec runs /usr/bin; those helpers refuse to elevate until the package is refreshed."
fi
if [[ $package_sources == 1 ]]; then
  ensure_dev_package_sources
fi
restart_live_shell

if command -v omarchy-notification-send >/dev/null; then
  omarchy-notification-send "omarchy-dev-sync" "$integration rebuilt on $upstream/$head: $pr_count PRs, $newest. $push_status." >/dev/null 2>&1 || true
fi

echo "Upstream $head: $(git rev-parse --short "$upstream/$head")"
echo "$integration: $newest ($pr_count PRs). $push_status."
echo "Checked out in $repo; dev-link environment now runs the integration build."
